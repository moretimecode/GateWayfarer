# Auto detect text files and perform LF normalization
* text=auto

# C# files
*.cs text diff=csharp
*.csproj text diff=csharp
*.sln text diff=csharp

# XML files
*.xml text

# JSON files
*.json text

# Markdown
*.md text

# Scripts
*.sh text eol=lf
*.ps1 text eol=crlf

# Binary files
*.dll binary
*.exe binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
